# Copy to .env and adjust. Every value shown is the default.

# SQLAlchemy database URL. SQLite standalone; in Docker, e.g.
# postgresql+psycopg://drivenow:drivenow@postgres:5432/drivenow
DATABASE_URL=sqlite:///./drivenow.db

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/drivenow.log
WORKER_LOG_FILE=logs/worker.log

# RabbitMQ AMQP URL. Leave empty to run without a broker (events are dropped).
# e.g. amqp://drivenow:drivenow@localhost:5672/ (the docker-compose broker)
RABBITMQ_URL=

# Standalone API server
API_HOST=127.0.0.1
API_PORT=8000
